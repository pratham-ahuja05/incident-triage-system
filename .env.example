# Copy to .env and fill in. Used by docker-compose.yml (and by the Python service when run locally).

# --- Required ---
POSTGRES_PASSWORD=change-me
GROQ_API_KEY=your-groq-api-key
# Generate with: openssl rand -base64 64
JWT_SECRET=change-me-to-a-long-random-string

# --- Optional ---
SLACK_WEBHOOK_URL=
# Seed admin/analyst/viewer demo accounts and show demo-login buttons. Use false for a private deployment.
SEED_DEMO_USERS=true
# Host port for the dashboard
WEB_PORT=80

# --- Local (non-Docker) Python service only ---
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/triage_db
